# Default API URL baked into the build. Can be overridden at runtime via:
#   1. localStorage["conquest.apiUrl"]   (highest precedence; set via login-screen settings)
#   2. window.__CONQUEST_CONFIG__.apiUrl (from /config.js, edited post-build)
#   3. VITE_API_URL                      (this file, baked in at build time)
#   4. "http://localhost:8000"           (fallback default)
VITE_API_URL=http://localhost:8000

# Show the dev-login form on the login screen. The server gates this separately
# with CONQUEST_DEV_LOGIN, so this just controls whether the UI is visible.
VITE_DEV_LOGIN=1

# Google OAuth client ID. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
